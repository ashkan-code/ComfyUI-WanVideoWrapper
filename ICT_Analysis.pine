// Pine Script v5 | TradingView

//@version=5
indicator("ICT Full Analysis - 100 Candles", overlay=true, max_bars_back=500, max_lines_count=200, max_boxes_count=200, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════

// Market Structure
grp_ms = "═══ Market Structure ═══"
show_bos       = input.bool(true,  "Show BOS (Break of Structure)",  group=grp_ms)
show_choch     = input.bool(true,  "Show CHoCH (Change of Character)", group=grp_ms)
swing_len      = input.int(10,     "Swing Lookback",  minval=3, maxval=50, group=grp_ms)

// Order Blocks
grp_ob = "═══ Order Blocks ═══"
show_ob        = input.bool(true,  "Show Order Blocks",  group=grp_ob)
ob_lookback    = input.int(100,    "OB Lookback (candles)",  minval=10, maxval=100, group=grp_ob)
bull_ob_col    = input.color(color.new(color.teal,  75), "Bullish OB Color",  group=grp_ob)
bear_ob_col    = input.color(color.new(color.red,   75), "Bearish OB Color",  group=grp_ob)

// Fair Value Gaps
grp_fvg = "═══ Fair Value Gaps ═══"
show_fvg       = input.bool(true,  "Show FVG / Imbalance",  group=grp_fvg)
fvg_bull_col   = input.color(color.new(color.lime,  80), "Bullish FVG",  group=grp_fvg)
fvg_bear_col   = input.color(color.new(color.orange,80), "Bearish FVG",  group=grp_fvg)
fvg_min_size   = input.float(0.0,  "Min FVG Size (% of price)",  minval=0.0, step=0.01, group=grp_fvg)

// Liquidity
grp_liq = "═══ Liquidity ═══"
show_liq       = input.bool(true,  "Show Liquidity Levels",  group=grp_liq)
show_eqhl      = input.bool(true,  "Show Equal H/L (EQH/EQL)",  group=grp_liq)
eq_threshold   = input.float(0.05, "EQH/EQL Threshold (%)",  minval=0.01, step=0.01, group=grp_liq)

// Premium / Discount
grp_pd = "═══ Premium & Discount ═══"
show_pd        = input.bool(true,  "Show Premium/Discount Range", group=grp_pd)
show_eq        = input.bool(true,  "Show Equilibrium (50%)",      group=grp_pd)

// Kill Zones (UTC)
grp_kz = "═══ Kill Zones (UTC) ═══"
show_kz        = input.bool(true,  "Show Kill Zones",  group=grp_kz)
kz_asia_col    = input.color(color.new(color.purple, 88), "Asian KZ",  group=grp_kz)
kz_london_col  = input.color(color.new(color.blue,   85), "London KZ", group=grp_kz)
kz_ny_col      = input.color(color.new(color.orange, 85), "NY KZ",     group=grp_kz)

// Dashboard
grp_dash = "═══ Dashboard ═══"
show_dash      = input.bool(true,  "Show Info Table",  group=grp_dash)
dash_pos       = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_dash)

// ═══════════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════════

LOOKBACK = 100  // fixed 100-candle analysis window

f_highest(src, len) =>
    math.max(ta.highest(src, len), src)

f_lowest(src, len) =>
    math.min(ta.lowest(src, len), src)

// Pivot high / low (unconfirmed until swing_len bars later)
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low,   swing_len, swing_len)

// ═══════════════════════════════════════════════════════════════════
//  1. SWING HIGH / LOW TRACKING (within 100 bars)
// ═══════════════════════════════════════════════════════════════════

var float swing_high_price = na
var int   swing_high_bar   = na
var float swing_low_price  = na
var int   swing_low_bar    = na

var float prev_swing_high  = na
var float prev_swing_low   = na

if not na(ph)
    prev_swing_high  := swing_high_price
    swing_high_price := ph
    swing_high_bar   := bar_index - swing_len

if not na(pl)
    prev_swing_low   := swing_low_price
    swing_low_price  := pl
    swing_low_bar    := bar_index - swing_len

// ═══════════════════════════════════════════════════════════════════
//  2. MARKET STRUCTURE - BOS & CHoCH
// ═══════════════════════════════════════════════════════════════════

var string market_bias  = "Neutral"
var int    bias_changes = 0

// BOS Bullish: price closes above last swing high → trend continues up
bos_bull = not na(swing_high_price) and close > swing_high_price and close[1] <= swing_high_price[1]
// BOS Bearish: price closes below last swing low
bos_bear = not na(swing_low_price)  and close < swing_low_price  and close[1] >= swing_low_price[1]

// CHoCH: structure flip (was bullish, now breaks swing low = CHoCH down)
choch_bear = market_bias == "Bullish" and bos_bear
choch_bull = market_bias == "Bearish" and bos_bull

if bos_bull or choch_bull
    market_bias  := "Bullish"
    bias_changes += 1
if bos_bear or choch_bear
    market_bias  := "Bearish"
    bias_changes += 1

// Draw BOS / CHoCH labels
if show_bos and bos_bull and not choch_bull
    label.new(bar_index, low, "BOS ▲", style=label.style_label_up,
              color=color.new(color.teal,0), textcolor=color.white, size=size.small)
if show_bos and bos_bear and not choch_bear
    label.new(bar_index, high, "BOS ▼", style=label.style_label_down,
              color=color.new(color.red,0),  textcolor=color.white, size=size.small)
if show_choch and choch_bull
    label.new(bar_index, low, "CHoCH ▲", style=label.style_label_up,
              color=color.new(color.yellow,0), textcolor=color.black, size=size.small)
if show_choch and choch_bear
    label.new(bar_index, high, "CHoCH ▼", style=label.style_label_down,
              color=color.new(color.yellow,0), textcolor=color.black, size=size.small)

// ═══════════════════════════════════════════════════════════════════
//  3. ORDER BLOCKS
// ═══════════════════════════════════════════════════════════════════

// Bullish OB: last down-candle before a strong up-move (displacement up)
// Bearish OB: last up-candle before a strong down-move (displacement down)

f_is_displacement_up(idx) =>
    // body of idx candle is at least 1.5× average body of prev 5
    body_now  = math.abs(close[idx] - open[idx])
    avg_body  = (math.abs(close[idx+1]-open[idx+1]) + math.abs(close[idx+2]-open[idx+2]) +
                 math.abs(close[idx+3]-open[idx+3]) + math.abs(close[idx+4]-open[idx+4]) +
                 math.abs(close[idx+5]-open[idx+5])) / 5
    close[idx] > open[idx] and body_now >= avg_body * 1.5

f_is_displacement_dn(idx) =>
    body_now  = math.abs(close[idx] - open[idx])
    avg_body  = (math.abs(close[idx+1]-open[idx+1]) + math.abs(close[idx+2]-open[idx+2]) +
                 math.abs(close[idx+3]-open[idx+3]) + math.abs(close[idx+4]-open[idx+4]) +
                 math.abs(close[idx+5]-open[idx+5])) / 5
    close[idx] < open[idx] and body_now >= avg_body * 1.5

var int   bull_ob_count = 0
var int   bear_ob_count = 0

// Detect and draw OBs once per bar (look 1 bar back for confirmation)
if show_ob and bar_index >= ob_lookback
    // Bullish OB: bar[1] is bearish, bar[0] is displacement up
    if close[1] < open[1] and f_is_displacement_up(0)
        box.new(bar_index-1, math.max(open[1], close[1]),
                bar_index + 20, math.min(open[1], close[1]),
                border_color=color.teal, bgcolor=bull_ob_col,
                border_width=1, extend=extend.right)
        label.new(bar_index-1, math.max(open[1], close[1]),
                  "Bull OB", style=label.style_label_right,
                  color=color.new(color.teal,0), textcolor=color.white, size=size.tiny)
        bull_ob_count += 1

    // Bearish OB: bar[1] is bullish, bar[0] is displacement down
    if close[1] > open[1] and f_is_displacement_dn(0)
        box.new(bar_index-1, math.max(open[1], close[1]),
                bar_index + 20, math.min(open[1], close[1]),
                border_color=color.red, bgcolor=bear_ob_col,
                border_width=1, extend=extend.right)
        label.new(bar_index-1, math.max(open[1], close[1]),
                  "Bear OB", style=label.style_label_right,
                  color=color.new(color.red,0), textcolor=color.white, size=size.tiny)
        bear_ob_count += 1

// ═══════════════════════════════════════════════════════════════════
//  4. FAIR VALUE GAPS (FVG / Imbalance)
// ═══════════════════════════════════════════════════════════════════

var int fvg_bull_count = 0
var int fvg_bear_count = 0

// Bullish FVG: gap between high[2] and low[0]  (candle[1] is impulse up)
bull_fvg_top    = low[0]
bull_fvg_bot    = high[2]
bull_fvg_exists = bull_fvg_top > bull_fvg_bot

// Bearish FVG: gap between low[2] and high[0]
bear_fvg_bot    = high[0]
bear_fvg_top    = low[2]
bear_fvg_exists = bear_fvg_top > bear_fvg_bot  // low[2] > high[0]? no → bear_fvg_top = low[2] < high[0]=bear_fvg_bot

// Recalc properly
bull_fvg_valid  = low[0] > high[2] and (low[0] - high[2]) / close * 100 >= fvg_min_size
bear_fvg_valid  = high[0] < low[2] and (low[2] - high[0]) / close * 100 >= fvg_min_size

if show_fvg and bull_fvg_valid
    box.new(bar_index-2, low[0], bar_index + 15, high[2],
            border_color=color.lime, bgcolor=fvg_bull_col,
            border_width=1, extend=extend.right)
    fvg_bull_count += 1

if show_fvg and bear_fvg_valid
    box.new(bar_index-2, low[2], bar_index + 15, high[0],
            border_color=color.orange, bgcolor=fvg_bear_col,
            border_width=1, extend=extend.right)
    fvg_bear_count += 1

// ═══════════════════════════════════════════════════════════════════
//  5. LIQUIDITY LEVELS & EQUAL HIGHS / LOWS
// ═══════════════════════════════════════════════════════════════════

// Buy-Side Liquidity (BSL): resting above swing highs
// Sell-Side Liquidity (SSL): resting below swing lows

hh_100 = ta.highest(high, LOOKBACK)
ll_100 = ta.lowest(low,   LOOKBACK)

if show_liq
    if ta.highestbars(high, LOOKBACK) == 0  // current bar is the HH
        line.new(bar_index - LOOKBACK, hh_100, bar_index, hh_100,
                 color=color.new(color.red, 0), style=line.style_dashed, width=1)
        label.new(bar_index, hh_100, "BSL", style=label.style_label_left,
                  color=color.new(color.red,0), textcolor=color.white, size=size.tiny)

    if ta.lowestbars(low, LOOKBACK) == 0    // current bar is the LL
        line.new(bar_index - LOOKBACK, ll_100, bar_index, ll_100,
                 color=color.new(color.lime, 0), style=line.style_dashed, width=1)
        label.new(bar_index, ll_100, "SSL", style=label.style_label_left,
                  color=color.new(color.lime,0), textcolor=color.black, size=size.tiny)

// Equal Highs (EQH) and Equal Lows (EQL)
var float prev_ph_val = na
var float prev_pl_val = na

if not na(ph)
    if not na(prev_ph_val)
        pct_diff_h = math.abs(ph - prev_ph_val) / prev_ph_val * 100
        if show_eqhl and pct_diff_h <= eq_threshold
            line.new(bar_index - swing_len * 2, prev_ph_val,
                     bar_index,                 ph,
                     color=color.new(color.red, 0), style=line.style_dotted, width=2)
            label.new(bar_index, ph, "EQH", style=label.style_label_left,
                      color=color.new(color.red,20), textcolor=color.white, size=size.tiny)
    prev_ph_val := ph

if not na(pl)
    if not na(prev_pl_val)
        pct_diff_l = math.abs(pl - prev_pl_val) / prev_pl_val * 100
        if show_eqhl and pct_diff_l <= eq_threshold
            line.new(bar_index - swing_len * 2, prev_pl_val,
                     bar_index,                 pl,
                     color=color.new(color.lime, 0), style=line.style_dotted, width=2)
            label.new(bar_index, pl, "EQL", style=label.style_label_left,
                      color=color.new(color.lime,20), textcolor=color.black, size=size.tiny)
    prev_pl_val := pl

// ═══════════════════════════════════════════════════════════════════
//  6. PREMIUM & DISCOUNT ZONES (based on 100-bar range)
// ═══════════════════════════════════════════════════════════════════

range_high = ta.highest(high, LOOKBACK)
range_low  = ta.lowest(low,   LOOKBACK)
range_mid  = (range_high + range_low) / 2
premium_lo = range_mid + (range_high - range_mid) * 0.5   // 75% of range
discount_hi = range_mid - (range_mid - range_low) * 0.5   // 25% of range

// Determine current price zone
price_zone = close > range_mid ? "Premium" : "Discount"

// Draw premium/discount on last visible bar
if show_pd and barstate.islast
    // Premium zone (above midpoint)
    box.new(bar_index - LOOKBACK, range_high, bar_index, range_mid,
            bgcolor=color.new(color.red,  92), border_color=color.new(color.red, 60))
    // Discount zone (below midpoint)
    box.new(bar_index - LOOKBACK, range_mid,  bar_index, range_low,
            bgcolor=color.new(color.teal, 92), border_color=color.new(color.teal, 60))
    // Equilibrium line
    if show_eq
        line.new(bar_index - LOOKBACK, range_mid, bar_index, range_mid,
                 color=color.new(color.yellow, 0), style=line.style_dashed, width=2)
        label.new(bar_index, range_mid, "EQ (50%)",
                  style=label.style_label_left, color=color.new(color.yellow, 0),
                  textcolor=color.black, size=size.small)
    // OTE zone: 62-79% retracement (Fibonacci)
    ote_high = range_high - (range_high - range_low) * 0.62
    ote_low  = range_high - (range_high - range_low) * 0.79
    box.new(bar_index - LOOKBACK, ote_high, bar_index, ote_low,
            bgcolor=color.new(color.purple, 88), border_color=color.new(color.purple, 50))
    label.new(bar_index, (ote_high + ote_low)/2, "OTE 62-79%",
              style=label.style_label_left, color=color.new(color.purple, 0),
              textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
//  7. KILL ZONES (UTC session times)
// ═══════════════════════════════════════════════════════════════════

// Asian KZ:  20:00 - 00:00 UTC
// London KZ: 02:00 - 05:00 UTC
// NY KZ:     07:00 - 10:00 UTC (AM session)
// NY PM:     13:00 - 16:00 UTC

is_asian  = (hour(time, "UTC") >= 20) or  (hour(time, "UTC") < 0)  // 20-24
is_london = (hour(time, "UTC") >= 2  and hour(time, "UTC") < 5)
is_ny     = (hour(time, "UTC") >= 7  and hour(time, "UTC") < 10)
is_ny_pm  = (hour(time, "UTC") >= 13 and hour(time, "UTC") < 16)

// Fix Asian KZ crossing midnight
is_asian_fixed = hour(time, "UTC") >= 20 or hour(time, "UTC") < 1

bgcolor(show_kz and is_asian_fixed ? kz_asia_col   : na, title="Asian KZ")
bgcolor(show_kz and is_london      ? kz_london_col  : na, title="London KZ")
bgcolor(show_kz and is_ny          ? kz_ny_col      : na, title="NY AM KZ")
bgcolor(show_kz and is_ny_pm       ? color.new(color.red, 90) : na, title="NY PM KZ")

// ═══════════════════════════════════════════════════════════════════
//  8. DISPLACEMENT DETECTION
// ═══════════════════════════════════════════════════════════════════

avg_range_5 = (ta.atr(5))
displacement_up   = close > open and (high - low) >= avg_range_5 * 2.0 and close >= high - (high - low) * 0.25
displacement_down = close < open and (high - low) >= avg_range_5 * 2.0 and close <= low  + (high - low) * 0.25

plotshape(displacement_up,   "Displacement Up",   shape.triangleup,   location.belowbar, color.new(color.aqua,  0), size=size.tiny)
plotshape(displacement_down, "Displacement Down",  shape.triangledown, location.abovebar, color.new(color.orange,0), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
//  9. POWER OF 3 (PO3) - Accumulation / Manipulation / Distribution
// ═══════════════════════════════════════════════════════════════════

// Session range for PO3 (using daily open as reference)
daily_open  = request.security(syminfo.tickerid, "D", open)
daily_high  = request.security(syminfo.tickerid, "D", high)
daily_low   = request.security(syminfo.tickerid, "D", low)

// PO3 bias: if price sweeps daily low then rallies → bullish PO3
po3_bull = low < daily_low[1] and close > daily_open  // manipulation down then distribution up
po3_bear = high > daily_high[1] and close < daily_open // manipulation up then distribution down

// ═══════════════════════════════════════════════════════════════════
//  10. MARKET MAKER MODEL DETECTION
// ═══════════════════════════════════════════════════════════════════

// SMT Divergence (simplified: price makes new high but momentum diverges)
// Approximated via RSI divergence as SMT proxy
rsi_val     = ta.rsi(close, 14)
smt_bull    = low < ta.lowest(low, 5)[1] and rsi_val > ta.lowest(rsi_val, 5)[1]
smt_bear    = high > ta.highest(high, 5)[1] and rsi_val < ta.highest(rsi_val, 5)[1]

plotshape(smt_bull, "SMT Bull Div", shape.diamond, location.belowbar, color.new(color.cyan,   0), size=size.tiny)
plotshape(smt_bear, "SMT Bear Div", shape.diamond, location.abovebar, color.new(color.fuchsia,0), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
//  11. INDUCEMENT DETECTION
// ═══════════════════════════════════════════════════════════════════

// Price creates a small swing that sweeps previous structure before reversing
inducement_bull = not na(pl) and pl < swing_low_price[1] and close > pl
inducement_bear = not na(ph) and ph > swing_high_price[1] and close < ph

if inducement_bull
    label.new(bar_index - swing_len, pl, "IDM", style=label.style_label_up,
              color=color.new(color.yellow, 20), textcolor=color.black, size=size.tiny)
if inducement_bear
    label.new(bar_index - swing_len, ph, "IDM", style=label.style_label_down,
              color=color.new(color.yellow, 20), textcolor=color.black, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
//  12. SWING HIGH / LOW LINES (100-bar)
// ═══════════════════════════════════════════════════════════════════

plot(swing_high_price, "Last Swing High", color.new(color.red,  40), linewidth=1, style=plot.style_linebr)
plot(swing_low_price,  "Last Swing Low",  color.new(color.teal, 40), linewidth=1, style=plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════
//  13. DASHBOARD TABLE
// ═══════════════════════════════════════════════════════════════════

tpos = switch dash_pos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

if show_dash and barstate.islast
    var table t = table.new(tpos, 2, 14,
                            bgcolor=color.new(color.black, 10),
                            border_color=color.new(color.gray, 40),
                            border_width=1, frame_color=color.gray, frame_width=1)

    cell_hdr(col, row, txt) =>
        table.cell(t, col, row, txt, text_color=color.white,
                   bgcolor=color.new(color.navy,10), text_size=size.small)

    cell_val(col, row, txt, col_bg) =>
        table.cell(t, col, row, txt, text_color=color.white,
                   bgcolor=col_bg, text_size=size.small)

    bias_col  = market_bias == "Bullish" ? color.new(color.teal,30) :
                market_bias == "Bearish" ? color.new(color.red, 30) : color.new(color.gray,30)
    zone_col  = price_zone  == "Premium" ? color.new(color.red, 40) : color.new(color.teal, 40)
    po3_txt   = po3_bull ? "Bull PO3" : po3_bear ? "Bear PO3" : "–"
    po3_col   = po3_bull ? color.new(color.teal,30) : po3_bear ? color.new(color.red,30) : color.new(color.gray,50)
    kz_txt    = is_asian_fixed ? "Asian" : is_london ? "London" : is_ny ? "NY AM" : is_ny_pm ? "NY PM" : "Off-KZ"
    kz_col    = is_asian_fixed ? color.new(color.purple,40) : is_london ? color.new(color.blue,40) :
                is_ny or is_ny_pm ? color.new(color.orange,40) : color.new(color.gray,60)
    disp_txt  = displacement_up ? "▲ Up" : displacement_down ? "▼ Down" : "–"
    disp_col  = displacement_up ? color.new(color.teal,30) : displacement_down ? color.new(color.red,30) : color.new(color.gray,50)

    // Header
    table.cell(t, 0, 0, "ICT Analysis (100)", text_color=color.yellow,
               bgcolor=color.new(color.navy,0), text_size=size.normal)
    table.cell(t, 1, 0, syminfo.ticker + " " + timeframe.period + "m",
               text_color=color.yellow, bgcolor=color.new(color.navy,0), text_size=size.normal)

    cell_hdr(0,1,"Metric")         ; cell_hdr(1,1,"Value")
    cell_hdr(0,2,"Market Bias")    ; cell_val(1,2, market_bias,   bias_col)
    cell_hdr(0,3,"Price Zone")     ; cell_val(1,3, price_zone,    zone_col)
    cell_hdr(0,4,"Kill Zone")      ; cell_val(1,4, kz_txt,        kz_col)
    cell_hdr(0,5,"Power of 3")     ; cell_val(1,5, po3_txt,       po3_col)
    cell_hdr(0,6,"Displacement")   ; cell_val(1,6, disp_txt,      disp_col)
    cell_hdr(0,7,"Bull OBs Found") ; cell_val(1,7, str.tostring(bull_ob_count), color.new(color.teal,40))
    cell_hdr(0,8,"Bear OBs Found") ; cell_val(1,8, str.tostring(bear_ob_count), color.new(color.red, 40))
    cell_hdr(0,9,"Bull FVGs")      ; cell_val(1,9, str.tostring(fvg_bull_count), color.new(color.lime,40))
    cell_hdr(0,10,"Bear FVGs")     ; cell_val(1,10,str.tostring(fvg_bear_count), color.new(color.orange,40))
    cell_hdr(0,11,"Range High")    ; cell_val(1,11,str.tostring(range_high, format.mintick), color.new(color.gray,50))
    cell_hdr(0,12,"Equilibrium")   ; cell_val(1,12,str.tostring(range_mid,  format.mintick), color.new(color.yellow,50))
    cell_hdr(0,13,"Range Low")     ; cell_val(1,13,str.tostring(range_low,  format.mintick), color.new(color.gray,50))

