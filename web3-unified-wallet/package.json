{
  "name": "web3-unified-wallet",
  "version": "1.0.0",
  "description": "Production-ready Web3 wallet dashboard — Electron + React + ethers.js v6",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n \"Vite,Electron\" -c \"cyan,yellow\" \"vite\" \"npm run electron:await\"",
    "electron:await": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron dist-electron/main.js",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:start": "cross-env NODE_ENV=development electron dist-electron/main.js",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "ethers": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.web3unified.wallet",
    "productName": "Web3 Unified Wallet",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"]
  }
}
