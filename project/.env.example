# XT Exchange MCP Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All variables are prefixed with XT_

# API Credentials (unused in Phase 1 read-only mode, but accepted by config schema)
XT_API_KEY=
XT_API_SECRET=

# Optional: Override API base URLs (e.g. for a proxy or regional endpoint)
# XT_SPOT_BASE_URL=https://sapi.xt.com
# XT_FUTURES_BASE_URL=https://fapi.xt.com

# Optional: HTTP tuning
# XT_HTTP_TIMEOUT_S=10.0
# XT_HTTP_CONNECT_TIMEOUT_S=5.0
# XT_MAX_CONNECTIONS=10
# XT_MAX_KEEPALIVE_CONNECTIONS=5

# Optional: Rate limiting (requests per second per market)
# XT_SPOT_RATE_LIMIT_RPS=10.0
# XT_FUTURES_RATE_LIMIT_RPS=10.0

# Optional: Retry policy
# XT_RETRY_MAX_ATTEMPTS=3
# XT_RETRY_MIN_WAIT_S=1.0
# XT_RETRY_MAX_WAIT_S=30.0

# Optional: Logging
# XT_LOG_LEVEL=INFO
# XT_LOG_FILE=logs/xt_mcp.log
# XT_LOG_MAX_BYTES=10485760
# XT_LOG_BACKUP_COUNT=3
